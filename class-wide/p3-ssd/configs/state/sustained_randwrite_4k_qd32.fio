[global]
filename=/home/suzukh/fio-test/testfile
size=8G
ioengine=libaio
direct=1
time_based=1
runtime=180
group_reporting=1
randrepeat=0
norandommap=1
refill_buffers=1
buffer_compress_percentage=0
lat_percentiles=1
clat_percentiles=0
percentile_list=50:90:95:99:99.9:99.99
ramp_time=0

[sustained_randwrite_4k_qd32]
rw=randwrite
bs=4k
iodepth=32
write_bw_log=results/raw/state/sustained
write_lat_log=results/raw/state/sustained
log_avg_msec=1000
